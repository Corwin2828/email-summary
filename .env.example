# ========== DeepSeek ==========
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# ========== AEBBS 企业邮箱专用模型 ==========
# 建议使用独立 API Key，避免客户询盘和个人邮件共用额度/日志策略。
BUSINESS_DEEPSEEK_API_KEY=sk-your-aebbs-key-here
BUSINESS_DEEPSEEK_BASE_URL=https://api.deepseek.com
BUSINESS_DEEPSEEK_MODEL=deepseek-v4-flash

# ========== Gmail (IMAP) ==========
# 需在 Google 账号开启两步验证并创建「应用专用密码」
GMAIL_ENABLED=true
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ========== Outlook 汇总邮箱 ==========
OUTLOOK_ENABLED=true
OUTLOOK_ADDRESS=you@outlook.com
# 个人 Outlook 已不支持应用密码登录 IMAP，请用 OAuth（推荐）
OUTLOOK_USE_OAUTH=true
# Azure 应用 Client ID（见 README「Outlook OAuth 配置」）
AZURE_CLIENT_ID=your-azure-client-id
# 仅当 OUTLOOK_USE_OAUTH=false 时使用（多数账户已失效）
OUTLOOK_APP_PASSWORD=

# ========== AEBBS / SiteGround 企业邮箱 ==========
# 支持 60 秒轮询；默认不使用夜间静默，客户询盘会持续监听。
BUSINESS_EMAIL_ENABLED=false
BUSINESS_EMAIL_NAME=aebbs-support
BUSINESS_EMAIL_ADDRESS=support@aebbstuning.com
BUSINESS_EMAIL_IMAP_HOST=mail.aebbstuning.com
BUSINESS_EMAIL_IMAP_PORT=993
BUSINESS_EMAIL_PASSWORD=
BUSINESS_POLL_INTERVAL_SEC=60
BUSINESS_IMAP_RETRY_WAIT_SEC=300
BUSINESS_QUIET_HOURS_ENABLED=false
# 防止漏询盘的保守默认值：启动时处理已有未读、失败自动重试，AEBBS 由更保守的 AI 过滤判断。
BUSINESS_PROCESS_EXISTING_UNREAD=true
BUSINESS_RETRY_FAILED_AFTER_SEC=120
BUSINESS_BYPASS_FILTER=false

# ========== 通知：飞书（推荐，详见 README「获取飞书 Webhook」）==========
# 桌面/网页飞书 → 群聊 → 设置 → 群机器人 → 自定义机器人 → 复制 Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx

# ========== 通知：企业微信（详见 README，个人微信不支持）==========
# 企业微信群 → 群机器人 → 添加 → 复制 Webhook
WECOM_WEBHOOK_URL=

# ========== AEBBS 询盘通知：独立机器人 ==========
# 请给 AEBBS 客户询盘单独建一个飞书/企微机器人，避免和个人邮件混在一起。
BUSINESS_FEISHU_WEBHOOK_URL=
BUSINESS_WECOM_WEBHOOK_URL=

# ========== AEBBS 知识库（RAG 预留）==========
# 后续可放产品、车型适配、报价规则、常见回复等资料。
BUSINESS_KNOWLEDGE_DIR=./knowledge/aebbs

# ========== 个人邮箱运行 ==========
# 个人邮箱轮询间隔（秒）；IMAP IDLE 断开后的备用轮询
# false=定时轮询（推荐）；true=IMAP IDLE（网络不稳易断）
IMAP_USE_IDLE=false
# 检查新邮件间隔（秒）：3600=1 小时
POLL_INTERVAL_SEC=3600
# Gmail 返回 OVERQUOTA 限流时的等待秒数（10800=3 小时）
IMAP_OVERQUOTA_WAIT_SEC=10800
# 无消息心跳告警：当队列里有待处理邮件且长时间无处理结果时告警
HEARTBEAT_ALERT_ENABLED=true
# 卡住阈值（秒）：7200=2 小时
HEARTBEAT_STALL_SEC=7200
# 检查间隔（秒）：300=5 分钟
HEARTBEAT_CHECK_SEC=300
# 已处理邮件数据库路径
DATA_DIR=./data
# 单封邮件送入模型的最大字符数
MAX_BODY_CHARS=12000
# 是否在过滤阶段用 AI 二次判断（更准但更费 token）
# 邮件过滤：ai=全部由 DeepSeek 判断是否总结（默认）；rules=本地规则（省 token）
FILTER_MODE=ai
# 推送文案：ai=DeepSeek 按 Prompt 生成整段飞书/企微消息（默认）；template=本地模板
NOTIFY_FORMAT=ai
# 每日简报（当前为预留配置，后续可启用定时汇总）
DAILY_DIGEST_ENABLED=false
DAILY_DIGEST_TIME=21:30
# true=每次启动总结收件箱全部未读（慎用，可能上千封）
PROCESS_EXISTING_UNREAD=false
# true=启动时补发「上次 Ctrl+C 退出后」收到的邮件（推荐，适合不能 24h 挂机）
CATCHUP_SINCE_LAST_RUN=true

# 可选：转发来源显示名（原邮箱地址:自定义名称）
# FORWARD_SOURCE_MAP=corwincc@outlook.com:学校Outlook,xxx@gmail.com:个人Gmail

# ========== 配置页面（./settings.sh）==========
# SSH tunnel 推荐保持 127.0.0.1，不要直接暴露公网。
WEB_HOST=127.0.0.1
WEB_PORT=8765
WEB_MAX_CONTENT_LENGTH=1048576
WEB_RAG_MAX_FILE_BYTES=200000
WEB_LOGIN_MAX_ATTEMPTS=8
WEB_LOGIN_WINDOW_SEC=600
WEB_COOKIE_SECURE=false
